---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? 'Docs';
const description = frontmatter?.description ?? Astro.props.description;

const currentPath = Astro.url.pathname.replace(/\/$/, '');

/* `chain` colours the dot in front of an entry: day = Cardano, night = Midnight,
   both = spans the two chains. Entries without a chain get no dot. */
const navItems = [
  { group: 'Getting Started', links: [
    { label: 'Get Started', href: '/docs/get-started' },
  ]},
  { group: 'Guides', links: [
    { label: 'ODATANO', hint: 'Cardano', chain: 'day', href: '/docs/odatano' },
    { label: 'NIGHTGATE', hint: 'Midnight', chain: 'night', href: '/docs/nightgate' },
    { label: 'NIGHTGATE TX', hint: 'Builder', chain: 'night', href: '/docs/nightgate-tx' },
    { label: 'ASTRA', hint: 'Analytics', chain: 'both', href: '/docs/astra' },
    { label: 'Hosted API', hint: 'One key', chain: 'both', href: '/docs/api' },
    { label: 'MCP servers', hint: 'AI agents', chain: 'both', href: '/docs/mcp' },
  ]},
  { group: 'Ecosystem', links: [
    { label: 'DAYPASS', chain: 'day', href: '/docs/daypass' },
    { label: 'NIGHTPASS', chain: 'night', href: '/docs/nightpass' },
    { label: 'DAYZERO', chain: 'day', href: '/docs/dayzero' },
    { label: 'TRACE', chain: 'day', href: '/docs/trace' },
    { label: 'QUANTIX', chain: 'day', href: '/docs/quantix' },
    { label: 'FINCA', chain: 'day', href: '/docs/finca' },
    { label: 'x402', chain: 'day', href: '/docs/x402' },
    { label: 'WATCH', chain: 'day', href: '/docs/watch' },
  ]},
  { group: 'Links', links: [
    { label: 'API', hint: 'get a key', href: 'https://api.preprod.odatano.dev/', external: true },
    { label: 'API reference', href: 'https://api.preprod.odatano.dev/reference', external: true },
    { label: 'GitHub', href: 'https://github.com/ODATANO', external: true },
  ]},
];
---

<Layout title={title} description={description}>
  <div class="docs-page">
    <aside class="docs-sidebar">
      <div class="docs-sidebar__head">
        <span class="docs-sidebar__title">Documentation</span>
      </div>
      <nav class="docs-sidebar__nav">
        {navItems.map(group => (
          <div class="docs-sidebar__group">
            <p class="docs-sidebar__group-label">{group.group}</p>
            {group.links.map(link => {
              const isExternal = 'external' in link && link.external;
              const active = !isExternal && (currentPath === link.href || currentPath === link.href + '/');
              return (
                <a
                  href={isExternal ? link.href : link.href + '/'}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener' : undefined}
                  class:list={['docs-sidebar__link', { active, 'docs-sidebar__link--external': isExternal }]}
                  aria-current={active ? 'page' : undefined}
                >
                  {'chain' in link && link.chain
                    ? <span class={`docs-sidebar__dot docs-sidebar__dot--${link.chain}`} aria-hidden="true"></span>
                    : null}
                  <span class="docs-sidebar__label">{link.label}</span>
                  {'hint' in link && link.hint ? <span class="docs-sidebar__hint">{link.hint}</span> : null}
                  {isExternal ? <span class="docs-sidebar__ext" aria-hidden="true">↗</span> : null}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    </aside>
    <article class="docs-content">
      <slot />
    </article>
  </div>
</Layout>

<script>
  const COPY_ICON = '<svg class="docs-copy-btn__icon docs-copy-btn__icon--copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
  const CHECK_ICON = '<svg class="docs-copy-btn__icon docs-copy-btn__icon--check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';

  const addCopyButtons = () => {
    document.querySelectorAll<HTMLPreElement>('.docs-content pre').forEach((pre) => {
      if (pre.querySelector('.docs-copy-btn')) return;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'docs-copy-btn';
      btn.setAttribute('aria-label', 'Copy code');
      btn.innerHTML = COPY_ICON + CHECK_ICON;
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        if (!code) return;
        const text = (code as HTMLElement).innerText;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
        }
        btn.classList.add('is-copied');
        btn.setAttribute('aria-label', 'Copied');
        window.setTimeout(() => {
          btn.classList.remove('is-copied');
          btn.setAttribute('aria-label', 'Copy code');
        }, 1800);
      });
      pre.appendChild(btn);
    });
  };

  addCopyButtons();
  document.addEventListener('astro:page-load', addCopyButtons);
</script>
