---
import "@odatano/brand/tokens.css";
import "../styles/global.css";
import faviconUrl from "@odatano/brand/logos/odatano-icon.svg?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Enterprise OData V4 services for the Cardano and Midnight blockchains, built on SAP CAP.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>ODATANO - {title}</title>
    <link rel="icon" href={faviconUrl} type="image/svg+xml" />
    <meta property="og:title" content={`ODATANO ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="https://odatano.dev/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`ODATANO ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://odatano.dev/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Day / Night: same storage key as the ODATANO Console (api.odatano.dev),
      // read before first paint so a choice made there holds here without a
      // flash. Night is the default (also set on <html> for no-JS visitors);
      // a stored choice wins. No system-preference detection on purpose.
      try {
        var t = localStorage.getItem("odatano.theme");
        document.documentElement.dataset.theme = (t === "night" || t === "day") ? t : "night";
      } catch (e) { document.documentElement.dataset.theme = "night"; }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

  </body>
</html>
