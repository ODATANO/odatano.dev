---
// The footer is dark at night and light in Day, so it needs both wordmarks.
import logoUrl from "@odatano/brand/logos/odatano-logo-on-dark.svg?url";
import logoDayUrl from "@odatano/brand/logos/odatano-logo.svg?url";
---

<footer class="site-footer site-footer--night">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <img class="only-night" src={logoUrl} alt="ODATANO" height="28" />
      <img class="only-day" src={logoDayUrl} alt="ODATANO" height="28" />
      <p>OData V4 API for Cardano &amp; Midnight</p>
    </div>
    <nav
      class="site-footer__links site-footer__links--content"
      aria-label="Site navigation"
    >
      <a href="/docs/get-started/">Get Started</a>
      <a href="/#ecosystem">Ecosystem</a>
      <a href="/docs/reference/">API Reference</a>
    </nav>
    <nav
      class="site-footer__links site-footer__links--legal"
      aria-label="More"
    >
      <a
        href="https://github.com/ODATANO"
        target="_blank"
        rel="noopener">GitHub</a
      >
      <a href="/imprint/">Imprint</a>
      <a href="/privacy/">Privacy</a>
    </nav>
    <p class="site-footer__copy">&copy; 2026 ODATANO</p>
  </div>
</footer>
