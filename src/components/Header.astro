---
import logoUrl from '@odatano/brand/logos/odatano-logo.svg?url';
import logoDarkUrl from '@odatano/brand/logos/odatano-logo-on-dark.svg?url';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img class="only-day" src={logoUrl} alt="ODATANO" height="102" />
      <img class="only-night" src={logoDarkUrl} alt="ODATANO" height="102" />
    </a>
    <nav class="site-header__nav site-header__nav--desktop">
      <div class="nav-links">
        <a href="/docs/get-started/">Docs</a>
        <a href="/#api">API</a>
        <a href="/#ecosystem">Ecosystem</a>
        <a href="https://github.com/ODATANO" target="_blank" rel="noopener">GitHub</a>
      </div>
      <a href="/docs/get-started/" class="btn btn--primary site-header__cta">Get Started</a>
      <button class="theme-toggle" type="button" title="Switch day / night" aria-label="Switch theme" data-theme-toggle>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>
    <div class="site-header__mobile-actions">
      <button class="theme-toggle" type="button" title="Switch day / night" aria-label="Switch theme" data-theme-toggle>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button
        class="site-header__toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="site-header__toggle-bar"></span>
        <span class="site-header__toggle-bar"></span>
        <span class="site-header__toggle-bar"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu lives OUTSIDE .site-header to escape its stacking context -->
<div class="mobile-nav" id="mobile-nav" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
  <div class="mobile-nav__panel">
    <a href="/docs/get-started/" class="mobile-nav__link">Docs</a>
    <a href="/#api" class="mobile-nav__link">API</a>
    <a href="/#ecosystem" class="mobile-nav__link">Ecosystem</a>
    <a href="https://github.com/ODATANO" target="_blank" rel="noopener" class="mobile-nav__link">GitHub</a>
    <a href="/docs/get-started/" class="btn btn--primary mobile-nav__cta">Get Started</a>
  </div>
</div>

<script is:inline>
  (function () {
    // Day / Night flip: same mechanism and storage key as the console
    // (api.odatano.dev/console.js). Flip data-theme, write the key, nothing else.
    document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'night' ? 'day' : 'night';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('odatano.theme', next); } catch (e) { /* private mode */ }
      });
    });

    var toggle = document.querySelector('[data-nav-toggle]');
    var nav = document.getElementById('mobile-nav');
    if (!toggle || !nav) return;

    var savedScrollY = 0;

    function lockScroll() {
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      document.body.style.top = '-' + savedScrollY + 'px';
      document.body.classList.add('nav-locked');
    }

    function unlockScroll() {
      document.body.classList.remove('nav-locked');
      document.body.style.top = '';
      window.scrollTo(0, savedScrollY);
    }

    function openNav() {
      toggle.setAttribute('aria-expanded', 'true');
      nav.hidden = false;
      // Force reflow so the transition runs
      void nav.offsetWidth;
      nav.classList.add('is-open');
      lockScroll();
    }

    function closeNav() {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      unlockScroll();
      // Hide after transition completes
      setTimeout(function () {
        if (toggle.getAttribute('aria-expanded') === 'false') nav.hidden = true;
      }, 220);
    }

    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      if (open) closeNav(); else openNav();
    });

    nav.addEventListener('click', function (e) {
      var t = e.target;
      while (t && t !== nav) {
        if (t.tagName === 'A') { closeNav(); return; }
        t = t.parentNode;
      }
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 940) closeNav();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeNav();
    });
  })();
</script>
