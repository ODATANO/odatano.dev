---
import daypassLogo from "@odatano/brand/logos/daypass-logo.svg?url";
import daypassLogoDark from "@odatano/brand/logos/daypass-logo-on-dark.svg?url";
import nightpassLogoLight from "@odatano/brand/logos/nightpass-logo-on-light.svg?url";
import nightpassLogoDark from "@odatano/brand/logos/nightpass-logo.svg?url";
import traceLogo from "@odatano/brand/logos/trace-logo.svg?url";
import traceLogoDark from "@odatano/brand/logos/trace-logo-on-dark.svg?url";
import quantixLogo from "@odatano/brand/logos/quantix-logo.svg?url";
import quantixLogoDark from "@odatano/brand/logos/quantix-logo-on-dark.svg?url";
import fincaLogo from "@odatano/brand/logos/finca-logo.svg?url";
import fincaLogoDark from "@odatano/brand/logos/finca-logo-on-dark.svg?url";
import x402Logo from "@odatano/brand/logos/x402-logo.svg?url";
import x402LogoDark from "@odatano/brand/logos/x402-logo-on-dark.svg?url";
import dayzeroLogo from "@odatano/brand/logos/dayzero-logo.svg?url";
import dayzeroLogoDark from "@odatano/brand/logos/dayzero-logo-on-dark.svg?url";
import watchLogo from "@odatano/brand/logos/watch-logo.svg?url";
import watchLogoDark from "@odatano/brand/logos/watch-logo-on-dark.svg?url";
import dppSdkLogo from "@odatano/brand/logos/dpp-sdk-logo.svg?url";
import dppSdkLogoDark from "@odatano/brand/logos/dpp-sdk-logo-on-dark.svg?url";
import cardanoStarburst from "../assets/logos/cardano-starburst-black.svg?url";
import cardanoStarburstWhite from "../assets/logos/cardano-starburst-white.svg?url";
import midnightSymbol from "../assets/logos/midnight-symbol-dark.svg?url";
import midnightSymbolWhite from "../assets/logos/midnight-symbol-white.svg?url";

/**
 * Ecosystem project card. Generalizes the former `.example-card` markup —
 * the `example-card` class is kept so existing card styles and the cursor
 * spotlight keep working; `.project-card` adds the compact/night variants.
 *
 * Logos: the product wordmark from @odatano/brand as a light / dark pair,
 * swapped with `.only-day` / `.only-night`; the chain badge is the official
 * Cardano starburst or the Midnight symbol. A card with `night` is dark in
 * both themes and always shows the dark files.
 */
interface Props {
  name: string;
  tag: string;
  tagVariant?: "default" | "accent";
  /** `both` for chain-agnostic libraries: shows the Cardano and Midnight symbols */
  track: "day" | "night" | "both";
  description: string;
  bullets: string[];
  docsHref?: string;
  repoHref: string;
  demoHref?: string;
  explorerHref?: string;
  npmHref?: string;
  night?: boolean;
  twin?: "day" | "night";
  icon?: "daypass" | "nightpass" | "trace" | "quantix" | "finca" | "x402" | "dayzero" | "watch" | "dpp-sdk";
}

// Product wordmarks from @odatano/brand: `light` sits on a light surface,
// `dark` on a dark one (the NIGHTGATE-family files are named the other way
// round in the kit: `nightpass-logo.svg` is the dark-surface file).
const logos = {
  daypass: { light: daypassLogo, dark: daypassLogoDark },
  nightpass: { light: nightpassLogoLight, dark: nightpassLogoDark },
  trace: { light: traceLogo, dark: traceLogoDark },
  quantix: { light: quantixLogo, dark: quantixLogoDark },
  finca: { light: fincaLogo, dark: fincaLogoDark },
  x402: { light: x402Logo, dark: x402LogoDark },
  dayzero: { light: dayzeroLogo, dark: dayzeroLogoDark },
  watch: { light: watchLogo, dark: watchLogoDark },
  "dpp-sdk": { light: dppSdkLogo, dark: dppSdkLogoDark },
};

const {
  name,
  tag,
  tagVariant = "default",
  track,
  description,
  bullets,
  docsHref,
  repoHref,
  demoHref,
  explorerHref,
  npmHref,
  night = false,
  twin,
  icon,
} = Astro.props;

const logo = icon ? logos[icon] : undefined;
const cardanoChain = { light: cardanoStarburst, dark: cardanoStarburstWhite, alt: "Cardano" };
const midnightChain = { light: midnightSymbol, dark: midnightSymbolWhite, alt: "Midnight" };
const chains =
  track === "day" ? [cardanoChain] : track === "night" ? [midnightChain] : [cardanoChain, midnightChain];
const chainTitle = chains.map((c) => c.alt).join(" · ");

const cardClass = [
  "example-card",
  "project-card",
  night && "project-card--night",
  twin && `ecosystem__twin ecosystem__twin--${twin}`,
]
  .filter(Boolean)
  .join(" ");
---

<article class={cardClass}>
  <div class="project-card__head">
    <span
      class={`example-card__tag${tagVariant === "accent" ? " example-card__tag--accent" : ""}`}
    >
      {tag}
    </span>
    <span class="project-card__chain" title={chainTitle}>
      {
        chains.map((chain) =>
          night ? (
            <img src={chain.dark} alt={chain.alt} />
          ) : (
            <>
              <img class="only-day" src={chain.light} alt={chain.alt} />
              <img class="only-night" src={chain.dark} alt={chain.alt} />
            </>
          )
        )
      }
    </span>
  </div>
  <div class="project-card__title">
    <h3 class={logo ? "has-logo" : undefined}>
      {
        logo ? (
          night ? (
            <img class="project-card__logo" src={logo.dark} alt={name} />
          ) : (
            <>
              <img class="project-card__logo only-day" src={logo.light} alt={name} />
              <img class="project-card__logo only-night" src={logo.dark} alt={name} />
            </>
          )
        ) : (
          name
        )
      }
    </h3>
  </div>
  <p class="example-card__desc" set:html={description} />
  <ul class="example-card__bullets">
    {bullets.map((b) => <li set:html={b} />)}
  </ul>
  <div class="example-card__actions">
    {
      demoHref && (
        <a
          href={demoHref}
          class={`btn ${night ? "btn--night" : "btn--primary"}`}
          target="_blank"
          rel="noopener"
        >
          Live Demo ↗
        </a>
      )
    }
    {
      explorerHref && (
        <a
          href={explorerHref}
          class="btn btn--outline"
          target="_blank"
          rel="noopener"
        >
          Explorer ↗
        </a>
      )
    }
    {
      docsHref && (
        <a
          href={docsHref}
          class={`btn ${demoHref ? "btn--outline" : night ? "btn--night" : "btn--primary"}`}
        >
          Learn More
        </a>
      )
    }
    {
      npmHref && (
        <a
          href={npmHref}
          class={`btn ${demoHref || docsHref ? "btn--outline" : night ? "btn--night" : "btn--primary"}`}
          target="_blank"
          rel="noopener"
        >
          npm ↗
        </a>
      )
    }
    <a
      href={repoHref}
      class="btn btn--outline"
      target="_blank"
      rel="noopener"
    >
      View Source
    </a>
  </div>
</article>
