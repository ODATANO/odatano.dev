---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

/* Chain logos (official Cardano and Midnight files, not in @odatano/brand)
   and the two product wordmarks. Each comes as a light / dark pair, swapped
   with `.only-day` / `.only-night`; surfaces that are dark in both themes
   use the dark file only. */
import cardanoBlue from "../assets/logos/cardano-horizontal-blue.svg?url";
import cardanoWhite from "../assets/logos/cardano-horizontal-white.svg?url";
import midnightDark from "../assets/logos/midnight-logo-horizontal-dark.svg?url";
import midnightWhite from "../assets/logos/midnight-logo-horizontal-white.svg?url";
import coreLogo from "@odatano/brand/logos/odatano-core-logo.svg?url";
import coreLogoDark from "@odatano/brand/logos/odatano-core-logo-on-dark.svg?url";
import nightgateLogoLight from "@odatano/brand/logos/nightgate-logo-on-light.svg?url";
import nightgateLogoDark from "@odatano/brand/logos/nightgate-logo.svg?url";
import astraLogo from "@odatano/brand/logos/astra-logo.svg?url";
import astraLogoDark from "@odatano/brand/logos/astra-logo-on-dark.svg?url";

const heroCode = `<span class="code-line code-comment"># 1 - read the chain as OData</span><span class="code-line"><span class="code-cmd">GET</span> api.preprod.odatano.dev/odata/v4/cardano-odata/Blocks</span><span class="code-line">    ?<span class="code-key">$orderby</span>=<span class="code-str">height desc</span>&amp;<span class="code-key">$top</span>=<span class="code-str">1</span></span><span class="code-line code-comment"># 200 { "value": [{ "height": 4123456, "txCount": 12 }] }</span><span class="code-line code-line--gap"></span><span class="code-line code-comment"># 2 - build a transaction as an OData action</span><span class="code-line"><span class="code-cmd">POST</span> …/cardano-transaction/BuildSimpleAdaTransaction</span><span class="code-line">  { <span class="code-key">&quot;senderAddress&quot;</span>: <span class="code-str">&quot;addr_test1…&quot;</span>,</span><span class="code-line">    <span class="code-key">&quot;recipientAddress&quot;</span>: <span class="code-str">&quot;addr_test1…&quot;</span>,</span><span class="code-line">    <span class="code-key">&quot;lovelaceAmount&quot;</span>: <span class="code-val">10000000</span> }</span><span class="code-line code-comment"># 200 { "unsignedTxCbor": "84a4…", "fee": 171001 }</span><span class="code-line code-line--gap"></span><span class="code-line code-comment"># 3 - same routes on Midnight, hosted or self-hosted</span><span class="code-line"><span class="code-cmd code-cmd--night">GET</span> …/odata/v4/nightgate/Blocks?$top=1</span>`;

/* `.mcp.json` snippet for the AI Agents section - both MCP servers against
   the hosted API (api.preprod.odatano.dev) with one `oda_…` key. Both servers send
   the key as `Authorization: Bearer` (ODATANO_ACCESS_KEY, both servers). */
const mcpCode = `<span class="code-line"><span class="code-cmd">npx</span> @odatano/core-mcp</span><span class="code-line"><span class="code-cmd code-cmd--night">npx</span> @odatano/nightgate-mcp</span><span class="code-line code-line--gap"></span><span class="code-line code-comment"># .mcp.json - Claude Code / Claude Desktop / Cursor / any MCP client</span><span class="code-line code-comment"># one key from api.preprod.odatano.dev, both chains</span><span class="code-line">{ <span class="code-key">"mcpServers"</span>: {</span><span class="code-line">  <span class="code-key">"odatano"</span>: {</span><span class="code-line">    <span class="code-key">"command"</span>: <span class="code-str">"npx"</span>,</span><span class="code-line">    <span class="code-key">"args"</span>: [<span class="code-str">"-y"</span>, <span class="code-str">"@odatano/core-mcp"</span>],</span><span class="code-line">    <span class="code-key">"env"</span>: { <span class="code-key">"ODATANO_ACCESS_KEY"</span>: <span class="code-str">"oda_…"</span> }</span><span class="code-line">  },</span><span class="code-line">  <span class="code-key">"nightgate"</span>: {</span><span class="code-line">    <span class="code-key">"command"</span>: <span class="code-str">"npx"</span>,</span><span class="code-line">    <span class="code-key">"args"</span>: [<span class="code-str">"-y"</span>, <span class="code-str">"@odatano/nightgate-mcp"</span>],</span><span class="code-line">    <span class="code-key">"env"</span>: { <span class="code-key">"ODATANO_ACCESS_KEY"</span>: <span class="code-str">"oda_…"</span> }</span><span class="code-line">  }</span><span class="code-line">}}</span><span class="code-line code-line--gap"></span><span class="code-line code-comment"># self-hosted instead: ODATANO_ACCESS_URL points at your own instance</span>`;

/* Contact form backend (Web3Forms). Get a free access key at
   https://web3forms.com — enter the email you want messages delivered to,
   then paste the key below. The form posts to Web3Forms, which emails you;
   no server of our own is involved (the site is static). */
const WEB3FORMS_KEY = "30cbb22d-de33-4a66-999c-4965c7166b7a";
---

<Layout
  title="OData for Cardano & Midnight"
  description="OData V4 API for Cardano and Midnight. Hosted with one key, or self-hosted standalone or as an SAP CAP plugin. For OData clients and AI agents."
>
  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 class="hero__headline">
          The <span class="hero__headline-accent">first</span> open source<br class="hero__headline-br" />
          OData service for<br class="hero__headline-br" />
          <span class="hero__headline-accent">Cardano</span>
          <span class="hero__headline-amp">&amp;</span>
          <span class="hero__headline-accent hero__headline-accent--night">Midnight</span>
        </h1>
        <p class="hero__sub">
          Read blocks, UTxOs and pools as OData entities, build and submit
          transactions as actions, and prove claims privately on Midnight.
          Use it hosted with one key, run it standalone, or add it to your
          CAP app as a plugin. Fiori, Excel, Power&nbsp;BI and AI agents
          call the same routes everywhere.
        </p>
        <div class="hero__actions">
          <a href="/docs/get-started/" class="btn btn--primary btn--lg">
            Get Started
          </a>
          <a
            href="https://github.com/ODATANO"
            class="btn btn--outline btn--lg"
            target="_blank"
            rel="noopener"
          >
            View on GitHub
          </a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__code-box">
          <div class="hero__code-chrome" aria-hidden="true">
            <span class="hero__code-glyph">&gt;_</span>
            <span class="hero__code-filename">OData V4</span>
          </div>
          <pre set:html={heroCode} />
        </div>
      </div>
    </div>
  </section>

  <!-- ── Stats Bar ─────────────────────────────────────────── -->
  <section class="stats-bar">
    <div class="container">
      <ul class="stats-bar__list">
        <li class="stats-bar__item">
          <span class="stats-bar__value">Apache 2.0</span>
          <span class="stats-bar__label">License</span>
        </li>
        <li class="stats-bar__item">
          <span class="stats-bar__value" data-npm-pkg="@odatano/core">v2.0.0-rc.14</span>
          <span class="stats-bar__label">@odatano/core</span>
        </li>
        <li class="stats-bar__item">
          <span class="stats-bar__value" data-npm-pkg="@odatano/core-mcp">v0.3.0</span>
          <span class="stats-bar__label">@odatano/core-mcp</span>
        </li>
        <li class="stats-bar__item">
          <span class="stats-bar__value" data-npm-pkg="@odatano/nightgate">v0.25.0</span>
          <span class="stats-bar__label">@odatano/nightgate</span>
        </li>
        <li class="stats-bar__item">
          <span class="stats-bar__value" data-npm-pkg="@odatano/nightgate-mcp">v0.7.0</span>
          <span class="stats-bar__label">@odatano/nightgate-mcp</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── Duality — Day / Night ─────────────────────────────── -->
  <section class="duality">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">
          Read, build, mint, sign, prove.
        </h2>
        <p class="section__subtitle">
          ODATANO CORE covers Cardano, NIGHTGATE covers Midnight. Read blocks
          and balances, build and submit transactions, mint assets, anchor
          documents and prove claims, all as OData.
        </p>
      </div>
      <div class="duality__grid">
        <div class="duality__panel duality__panel--day">
          <div class="duality__logos">
            <img class="duality__logo--product only-day" src={coreLogo} alt="ODATANO CORE" />
            <img class="duality__logo--product only-night" src={coreLogoDark} alt="ODATANO CORE" />
            <span class="duality__logos-spacer"></span>
            <img class="duality__logo--chain only-day" src={cardanoBlue} alt="Cardano" />
            <img class="duality__logo--chain only-night" src={cardanoWhite} alt="Cardano" />
          </div>
          <h3>Query, transact, mint, stake.</h3>
          <p>
            Blocks, addresses, UTxOs, pools and DReps as entities. ADA and
            multi-asset transfers, mints, metadata and Plutus spends as
            actions. Signing requests and submission included.
          </p>
          <div class="duality__chips">
            <span class="duality__chip">@odatano/core</span>
            <span class="duality__chip">@odatano/core-mcp</span>
          </div>
          <div class="duality__links">
            <a href="https://www.npmjs.com/package/@odatano/core" target="_blank" rel="noopener">npm ↗</a>
            <a href="https://github.com/ODATANO/ODATANO" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="/docs/get-started/">Docs</a>
          </div>
          <a href="#ecosystem" class="duality__link">Explore the Cardano track ↓</a>
        </div>
        <div class="duality__seam" aria-hidden="true"></div>
        <div class="duality__panel duality__panel--night">
          <div class="duality__logos">
            <img class="duality__logo--product only-day" src={nightgateLogoLight} alt="NIGHTGATE" />
            <img class="duality__logo--product only-night" src={nightgateLogoDark} alt="NIGHTGATE" />
            <span class="duality__logos-spacer"></span>
            <img class="duality__logo--chain only-day" src={midnightDark} alt="Midnight" />
            <img class="duality__logo--chain only-night" src={midnightWhite} alt="Midnight" />
          </div>
          <h3>Transfer, anchor, attest, prove.</h3>
          <p>
            Blocks and contract state as entities. Shielded transfers,
            Compact contract calls, document anchoring and zero-knowledge
            attestations as actions, sponsored so no NIGHT or DUST is needed.
          </p>
          <div class="duality__chips">
            <span class="duality__chip">@odatano/nightgate</span>
            <span class="duality__chip">@odatano/nightgate-mcp</span>
          </div>
          <div class="duality__links">
            <a href="https://www.npmjs.com/package/@odatano/nightgate" target="_blank" rel="noopener">npm ↗</a>
            <a href="https://github.com/ODATANO/NIGHTGATE" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="/docs/nightgate/">Docs</a>
          </div>
          <a href="#ecosystem" class="duality__link">Explore the Midnight track ↓</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── API — the hosted console (api.preprod.odatano.dev), in short ── -->
  <section class="section api" id="api">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">ODATANO API</h2>
        <p class="section__subtitle">
          Seamless enterprise and agentic access to Cardano and Midnight.
          One key for Fiori, Excel, Power BI and any OData client: read blocks, UTxOs and contract state, build and submit
          transactions, read the analytics. AI agents can use the same key through the two MCP
          servers.
        </p>
      </div>

      <div class="api__tiles">
        <article class="api__tile">
          <div class="api__tile-logos">
            <img class="via only-day" src={coreLogo} alt="ODATANO CORE" />
            <img class="via only-night" src={coreLogoDark} alt="ODATANO CORE" />
            <span class="spacer"></span>
            <img class="chain only-day" src={cardanoBlue} alt="Cardano" />
            <img class="chain only-night" src={cardanoWhite} alt="Cardano" />
          </div>
          <p>Blocks, transactions, UTxOs and pools as OData. Build and submit transactions.</p>
          <ul class="api__facts">
            <li><b>Routes</b><span class="mono">/odata/v4/cardano-odata<br />/odata/v4/cardano-transaction<br />/odata/v4/cardano-sign</span></li>
            <li><b>Network</b><span>preprod</span></li>
            <li><b>Read</b><span>blocks, transactions, UTxOs, addresses, pools, epochs, assets</span></li>
            <li><b>Transactions</b><span>unsigned ADA, multi-asset, mint, metadata and Plutus transactions</span></li>
            <li><b>Sign &amp; submit</b><span>signing requests, signature verification, submission</span></li>
          </ul>
        </article>
        <article class="api__tile api__tile--midnight">
          <div class="api__tile-logos">
            <img class="via only-day" src={nightgateLogoLight} alt="NIGHTGATE" />
            <img class="via only-night" src={nightgateLogoDark} alt="NIGHTGATE" />
            <span class="spacer"></span>
            <img class="chain only-day" src={midnightDark} alt="Midnight" />
            <img class="chain only-night" src={midnightWhite} alt="Midnight" />
          </div>
          <p>Blocks and contract state on Midnight. Attestations and zero-knowledge proofs, transactions sponsored.</p>
          <ul class="api__facts">
            <li><b>Routes</b><span class="mono">/odata/v4/nightgate<br />/odata/v4/nightgate-verify</span></li>
            <li><b>Network</b><span>Midnight preprod</span></li>
            <li><b>Read</b><span>blocks, transactions, contract state, job status</span></li>
            <li><b>Verify</b><span>attestations, predicates and documents against chain state</span></li>
            <li><b>Anchor</b><span>documents and agent output; sponsored, no NIGHT or DUST needed</span></li>
            <li><b>Prove</b><span>field, equality, membership, document integrity and diff attestations</span></li>
          </ul>
        </article>
        <article class="api__tile api__tile--astra">
          <div class="api__tile-logos">
            <img class="via only-day" src={astraLogo} alt="ODATANO ASTRA" />
            <img class="via only-night" src={astraLogoDark} alt="ODATANO ASTRA" />
            <span class="spacer"></span>
            <img class="chain only-day" src={cardanoBlue} alt="Cardano" />
            <img class="chain only-night" src={cardanoWhite} alt="Cardano" />
            <img class="chain only-day" src={midnightDark} alt="Midnight" />
            <img class="chain only-night" src={midnightWhite} alt="Midnight" />
          </div>
          <p>Analytics, computed from the same indexes. Blocks, transactions and fees per hour, day or week, with the change against the window before. Every number names the block range it came from.</p>
          <ul class="api__facts">
            <li><b>Route</b><span class="mono">/odata/v4/astra</span></li>
            <li><b>Agents</b><span><code>analytics_*</code> tools in both MCP servers</span></li>
            <li><b>Overview</b><span>ChainOverview: tip, lag, blocks and transactions in the last hour, fees over 24 h, one row per chain</span></li>
            <li><b>Key figures</b><span>KeyFigures: every metric over 1 h, 24 h, 7 d, 14 d and 30 d, with the previous window and the change in percent</span></li>
            <li><b>Per day</b><span>BlocksDaily, TransactionsDaily, FeesDaily, TokensDaily and StakeEpochs, one row per chain and day, named columns</span></li>
            <li><b>Rankings</b><span>TopTokens, TopPolicies, TopAddresses, TopScripts, TopBlockProducers, TopPools, TopDReps per chain and window</span></li>
            <li><b>Shape</b><span>compare for both chains side by side, getDistribution for histograms, getAnomalies for days off their own baseline</span></li>
          </ul>
        </article>
      </div>


      <!-- Three lanes to a key, one line each. The free start (calls, days)
           is what the console's /api/config reports today (ACCESS_FREE_UNITS
           50, ACCESS_KEY_DAYS 90); it has no CORS, so the numbers are kept
           in sync by hand. -->
      <div class="api__lanes">
        <div class="api__lane">
          <b>Cardano wallet</b>
          <span>Your wallet signs a one-time message, no transaction. <em>Free start: 50 calls, 90 days.</em></span>
        </div>
        <div class="api__lane">
          <b>x402</b>
          <span>Pay a pack with ADA or stablecoins over x402. The key comes back in the response. Top up by key id or from the paying wallet.</span>
        </div>
        <div class="api__lane">
          <b>Redeem a code</b>
          <span>A 6-character voucher from events, exchanged on the API page for a key.</span>
        </div>
      </div>

      <div class="api__footer">
        <a class="btn btn--primary" href="https://api.preprod.odatano.dev/" target="_blank" rel="noopener">Get a key ↗</a>
        <a class="btn btn--outline" href="https://api.preprod.odatano.dev/reference" target="_blank" rel="noopener">Reference ↗</a>
        <a class="btn btn--outline" href="/docs/astra/">ASTRA</a>
        <a class="btn btn--outline" href="/docs/x402/">x402</a>
      </div>
    </div>
  </section>

  <!-- ── Architecture ─────────────────────────────────────── -->
  <section class="arch-section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Architecture</h2>
        <p class="section__subtitle">
          ODATANO sits between your application and the chain. Fiori, Excel,
          Power BI or an AI agent read blocks, addresses and UTxOs as OData
          and submit transactions through the same service. ODATANO talks to
          Cardano, NIGHTGATE to Midnight. Both handle data providers, caching
          and transaction building.
        </p>
      </div>
      <div class="arch">
        <!-- Left: App -->
        <div class="arch__col arch__col--app">
          <p class="arch__col-title arch__col-title--app">
            <svg class="arch__col-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 18h6" />
              <path d="M10 21h4" />
              <path d="M8.5 15.5a6 6 0 1 1 7 0c-.9.7-1.5 1.5-1.5 2.5h-4c0-1-.6-1.8-1.5-2.5z" />
            </svg>
            Consumer
          </p>
          <div class="arch__col-chips">
            <span class="arch__chip">SAP Fiori / UI5</span>
            <span class="arch__chip">Any OData Client</span>
            <span class="arch__chip">REST / curl</span>
            <span class="arch__chip">AI Agents</span>
            <span class="arch__chip">MCP</span>
            <span class="arch__chip">Automated business processes</span>
          </div>
        </div>

        <!-- Connector 1: app → plugins -->
        <div class="arch__connector arch__connector--dual arch__connector--first" aria-hidden="true">
          <svg class="arch__flow" viewBox="0 0 100 24" preserveAspectRatio="none">
            <path class="arch__flow-path" d="M18 12 H82"></path>
            <polygon class="arch__flow-head" points="16,7 6,12 16,17"></polygon>
            <polygon class="arch__flow-head" points="84,7 94,12 84,17"></polygon>
          </svg>
          <svg class="arch__flow arch__flow--night" viewBox="0 0 100 24" preserveAspectRatio="none">
            <path class="arch__flow-path" d="M18 12 H82"></path>
            <polygon class="arch__flow-head" points="16,7 6,12 16,17"></polygon>
            <polygon class="arch__flow-head" points="84,7 94,12 84,17"></polygon>
          </svg>
        </div>

        <!-- Center: Plugins -->
        <div class="arch__cell">
          <div class="arch__col arch__col--plugin">
            <img class="arch__col-logo arch__col-logo--product only-day" src={coreLogo} alt="ODATANO CORE" />
            <img class="arch__col-logo arch__col-logo--product only-night" src={coreLogoDark} alt="ODATANO CORE" />
            <div class="arch__col-chips">
              <span class="arch__chip arch__chip--white">CardanoODataService</span>
              <span class="arch__chip arch__chip--white">CardanoTransactionService</span>
              <span class="arch__chip arch__chip--white">CardanoSignService</span>
              <span class="arch__chip arch__chip--white">CardanoIndexerService</span>
              <span class="arch__chip arch__chip--white">CardanoWorkerService</span>
              <span class="arch__chip arch__chip--white">CardanoAgentService</span>
            </div>
          </div>
          <div class="arch__col arch__col--plugin arch__col--plugin-night">
            <img class="arch__col-logo arch__col-logo--product only-day" src={nightgateLogoLight} alt="NIGHTGATE" />
            <img class="arch__col-logo arch__col-logo--product only-night" src={nightgateLogoDark} alt="NIGHTGATE" />
            <div class="arch__col-chips">
              <span class="arch__chip arch__chip--white">NightgateService</span>
              <span class="arch__chip arch__chip--white">NightgateIndexerService</span>
              <span class="arch__chip arch__chip--white">NightgateAnalyticsService</span>
              <span class="arch__chip arch__chip--white">NightgateAdminService</span>
              <span class="arch__chip arch__chip--white">NightgateVerifyService</span>
            </div>
          </div>
        </div>

        <!-- Connector 2: plugins → chains -->
        <div class="arch__connector arch__connector--dual arch__connector--second" aria-hidden="true">
          <svg class="arch__flow" viewBox="0 0 100 24" preserveAspectRatio="none">
            <path class="arch__flow-path" d="M18 12 H82"></path>
            <polygon class="arch__flow-head" points="16,7 6,12 16,17"></polygon>
            <polygon class="arch__flow-head" points="84,7 94,12 84,17"></polygon>
          </svg>
          <svg class="arch__flow arch__flow--night" viewBox="0 0 100 24" preserveAspectRatio="none">
            <path class="arch__flow-path" d="M18 12 H82"></path>
            <polygon class="arch__flow-head" points="16,7 6,12 16,17"></polygon>
            <polygon class="arch__flow-head" points="84,7 94,12 84,17"></polygon>
          </svg>
        </div>

        <!-- Right: Chains -->
        <div class="arch__cell">
          <div class="arch__col arch__col--chain">
            <img class="arch__col-logo only-day" src={cardanoBlue} alt="Cardano" />
            <img class="arch__col-logo only-night" src={cardanoWhite} alt="Cardano" />
            <div class="arch__col-chips">
              <span class="arch__chip">Mainnet</span>
              <span class="arch__chip">Preview</span>
              <span class="arch__chip">Preprod</span>
            </div>
          </div>
          <div class="arch__col arch__col--chain arch__col--chain-midnight">
            <img class="arch__col-logo only-day" src={midnightDark} alt="Midnight" />
            <img class="arch__col-logo only-night" src={midnightWhite} alt="Midnight" />
            <div class="arch__col-chips">
              <span class="arch__chip">Mainnet</span>
              <span class="arch__chip">Preview</span>
              <span class="arch__chip">Preprod</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Services ──────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2 class="section__title">Services</h2>
        <p class="section__subtitle">
          Both services expose their chain as OData V4 entities and actions.
          <code>$filter</code>, <code>$select</code>, <code>$expand</code>
          and <code>$orderby</code> work as in any OData service, metadata
          at <code>$metadata</code>. Hosted and self-hosted serve the same
          paths.
        </p>
      </div>

      <div class="services__group">
        <p class="services__group-title">
          <strong>@odatano/core</strong>
        </p>
        <div class="features__grid">
          <div class="feature-card">
            <div class="feature-card__icon">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
